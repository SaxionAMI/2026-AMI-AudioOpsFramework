FROM python:3.10-slim

LABEL maintainer="Your Name <you@example.com>"
LABEL description="Audio Ops Framework - Inference API (Lightweight)"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://install.python-poetry.org | python3 - && \
    export PATH="/root/.local/bin:$PATH" && \
    poetry config virtualenvs.create false

COPY audio-ops-inference/inference_pyproject.toml ./pyproject.toml
RUN export PATH="/root/.local/bin:$PATH" && \
    poetry install --no-interaction --no-ansi --no-directory

COPY audio-ops-inference ./audio-ops-inference
COPY config ./config

RUN mkdir -p /app/models /app/tmp

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "inference.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]