# Where this project's tasks live (the framework discovers them here).
AUDIO_OPS_TASKS_DIR=./tasks

# Storage / metrics / tracking are all optional (default local/off).
STORAGE_BACKEND=local
ENABLE_INFLUXDB=false
MLFLOW_TRACKING_URI=file:./mlruns

# Inference service (only if this project serves):
INFERENCE_PORT=8000
DEVICE=cpu
# ENABLE_FUSION=true   # e.g. a triage project using the fusion timeline
