# ./tasks is discovered automatically when you run from this folder.
# AUDIO_OPS_TASKS_DIR=./tasks
# Hide the framework's bundled example task.
AUDIO_OPS_DISABLE_BUILTIN_TASKS=true

# Storage / metrics / tracking are all optional (default local/off).
STORAGE_BACKEND=local
ENABLE_INFLUXDB=false
# MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# Inference service (only if this project serves):
INFERENCE_PORT=8000
DEVICE=auto
API_KEY=
# ENABLE_FUSION=true   # e.g. a call-analysis project using the fusion timeline
