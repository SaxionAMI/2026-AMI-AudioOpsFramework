# Audio Ops Framework — environment.
# Copy to .env (`make setup` does this). Every value has a working default;
# change one only to turn on an OPTIONAL integration. Full reference:
# docs/reference/environment.md

# ─────────────────────────── Core ───────────────────────────────────────────
# Extra task directories (your project's tasks), os.pathsep- or comma-separated.
AUDIO_OPS_TASKS_DIR=
# Hide the bundled example_classifier task (useful in project repos).
# AUDIO_OPS_DISABLE_BUILTIN_TASKS=true
# auto | cpu | cuda | cuda:N | mps
DEVICE=auto
AUDIO_OPS_LOG_LEVEL=INFO
DAGSTER_PORT=3000

# ─────────────────── Storage (OPTIONAL, default local) ───────────────────────
# local keeps artifacts on disk. "minio"/"s3" uses S3-compatible storage
# (MinIO, AWS S3, Cloudflare R2, Backblaze B2). Uploads still require a task to
# set use_remote_storage: true. Needs the s3 extra.
STORAGE_BACKEND=local
# MINIO_ENDPOINT=http://localhost:9000      # leave unset for AWS S3
# MINIO_ACCESS_KEY=                         # unset → boto3 default credential chain
# MINIO_SECRET_KEY=
# MINIO_BUCKET_NAME=audioops-bucket
# MINIO_REGION=us-east-1

# ─────────────────── Metrics (OPTIONAL, default off) ─────────────────────────
# Off → metric writes are no-ops. On → point at your InfluxDB v2. Needs the metrics extra.
ENABLE_INFLUXDB=false
# INFLUXDB_URL=http://localhost:8086
# INFLUXDB_TOKEN=
# INFLUXDB_ORG=audioops
# INFLUXDB_BUCKET=audio_metrics

# ─────────────── Experiment tracking (OPTIONAL, default local) ───────────────
# Local SQLite by default; point at a server with http://mlflow:5000.
# MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
# ENABLE_MLFLOW=false                       # disable tracking entirely

# ─────────────────── LLM + Fusion (OPTIONAL, default off) ────────────────────
ENABLE_LLM=false
# LLM_PROVIDER=ollama                       # ollama | openai_compatible (vLLM, LiteLLM, …)
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2
# LLM_API_KEY=
# Fusion = transcript + event + sentiment timeline (extras/fusion.py).
ENABLE_FUSION=false
# FUSION_LANGUAGE=en                        # en | nl

# ─────────────── Inference service (streaming) ───────────────────────────────
INFERENCE_PORT=8000
INFERENCE_WORKERS=1
# Require X-API-Key on every endpoint except /health (strongly recommended
# whenever the service is reachable by others).
API_KEY=
# CORS_ALLOW_ORIGINS=https://my-dashboard.example.com
# MAX_UPLOAD_MB=100
# Override the checkpoint batch inference / the API loads (all tasks):
# INFERENCE_CHECKPOINT=/path/to/best_model.pt
# Only weights-only checkpoints load by default; allow pickled full models (trusted files only):
# ALLOW_UNSAFE_CHECKPOINTS=false
CHUNK_MS=1000
# AUTO_RTSP_STREAMS=rtsp://mediamtx:8554/demo|demo
# STREAM_AUTODISCOVER=true                  # run models on every MediaMTX path
# STREAM_AUTODISCOVER_FILTER=^room_
