# Audio Ops Framework — environment.
# Copy to .env (`make setup` does this). Every value has a working default;
# change one only to turn on an OPTIONAL integration.

# ─────────────────────────── Core ───────────────────────────────────────────
DAGSTER_PORT=3000
DAGSTER_HOME=/app/dagster_home

# ─────────────────── Storage (OPTIONAL, default local) ───────────────────────
# local keeps artifacts on disk. "minio" uses S3/MinIO (boto3) — also works with
# AWS S3, Cloudflare R2, Backblaze B2. Uploads still require a task to set
# use_remote_storage: true.
STORAGE_BACKEND=local
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET_NAME=audioops-bucket

# ─────────────────── Metrics (OPTIONAL, default off) ─────────────────────────
# Off → metric writes are no-ops. On → point at your own InfluxDB v2.
ENABLE_INFLUXDB=false
# INFLUXDB_URL=http://localhost:8086
# INFLUXDB_TOKEN=
# INFLUXDB_ORG=audioops
# INFLUXDB_BUCKET=audio_metrics

# ─────────────── Experiment tracking (OPTIONAL, default local) ───────────────
MLFLOW_TRACKING_URI=file:/app/mlruns

# ─────────────────── LLM + Fusion (OPTIONAL, default off) ────────────────────
ENABLE_LLM=false
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2
# Fusion = transcript+event+sentiment timeline (extras/fusion.py).
ENABLE_FUSION=false

# ─────────────── Inference service (streaming) ───────────────────────────────
INFERENCE_PORT=8000
INFERENCE_WORKERS=1
DEVICE=cpu            # cuda with the GPU overlay + NVIDIA runtime
COMPUTE_TYPE=int8     # int8 | float16 | int8_float16  (STT)
# Override the checkpoint the batch inference / API loads:
# INFERENCE_CHECKPOINT=/path/to/best_model.pt
# Streaming knobs (advanced):
CHUNK_MS=1000
# AUTO_RTSP_STREAMS=rtsp://mediamtx:8554/mic
# Comma-separated task names the RTSP stream sensor should run (empty = manual):
STREAM_INFERENCE_TASKS=
