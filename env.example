# Audio Ops Framework — Environment Configuration
# Copy this file to .env and adjust as needed.
# This file is safe to commit. Do NOT put passwords here — use .secrets.env.
#
# Usage:
#   cp .env.example .env
#   docker-compose --env-file .env up -d

# ─────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_NAME=audio-ops-framework
APP_VERSION=1.0.0

# ─────────────────────────────────────────────────────
# Dagster  (pipeline orchestration)
# UI: http://localhost:${DAGSTER_PORT}
# ─────────────────────────────────────────────────────
DAGSTER_HOME=/app/dagster_home
DAGSTER_HOST=0.0.0.0
DAGSTER_PORT=3000
DAGSTER_LOG_LEVEL=INFO

# Active audio task — must match a folder name under audio_ops_dagster/tasks/
DAGSTER_AUDIO_TASK=sentiment

# ─────────────────────────────────────────────────────
# MLflow  (experiment tracking)
# UI: http://localhost:${MLFLOW_PORT}
# ─────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/data/mlflow.db
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
# Allowed hosts must include all names the server is reachable by
MLFLOW_ALLOWED_HOSTS=mlflow,localhost,127.0.0.1,audio-ops-mlflow,mlflow:5000,localhost:5000

# ─────────────────────────────────────────────────────
# MinIO  (S3-compatible object storage)
# API:     http://localhost:${MINIO_PORT}
# Console: http://localhost:${MINIO_CONSOLE_PORT}
# ─────────────────────────────────────────────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin           # Username — override in .secrets.env for prod
MINIO_BUCKET_NAME=audioops-bucket
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# ─────────────────────────────────────────────────────
# InfluxDB  (time-series metrics)
# UI: http://localhost:${INFLUXDB_PORT}
# ─────────────────────────────────────────────────────
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_ADMIN_USER=admin
INFLUXDB_INIT_ORG=audioops
INFLUXDB_INIT_BUCKET=audio_metrics
INFLUXDB_BUCKET=audio-ops            # Alias used by some docker env vars
INFLUXDB_ORG=audio-org               # Alias used by some docker env vars
INFLUXDB_RETENTION_POLICY=30d
DOCKER_INFLUXDB_INIT_MODE=setup      # Set to "upgrade" if migrating from InfluxDB 1.x

# ─────────────────────────────────────────────────────
# Inference Service  (FastAPI / uvicorn)
# API: http://localhost:${INFERENCE_PORT}
# ─────────────────────────────────────────────────────
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000
INFERENCE_WORKERS=4
INFERENCE_RELOAD=false               # true for local dev only, false in prod
INFERENCE_LOG_LEVEL=INFO
PYTHONPATH=/app:/app/audio_ops_dagster

# ─────────────────────────────────────────────────────
# Label Studio  (data labeling)
# UI: http://localhost:${LABEL_STUDIO_PORT}
# ─────────────────────────────────────────────────────
LABEL_STUDIO_PORT=8080
LABELSTUDIO_HOST=0.0.0.0
LABELSTUDIO_PORT=8080
ML_TIMEOUT_PREDICT=3600
ML_TIMEOUT_HEALTH=60
ML_TIMEOUT_TRAIN=7200
GUNICORN_CMD_ARGS=--timeout 36000 --graceful-timeout 36000 --workers 2

# ─────────────────────────────────────────────────────
# Grafana  (dashboards)
# UI: http://localhost:${GRAFANA_PORT}
# ─────────────────────────────────────────────────────
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GF_SECURITY_ALLOW_EMBEDDING=true
GF_PANELS_DISABLE_SANITIZE_HTML=true

# ─────────────────────────────────────────────────────
# Storage paths  (relative to project root)
# These are bind-mounted into the containers.
# ─────────────────────────────────────────────────────
STORAGE_DAGSTER_HOME=./dagster_home
STORAGE_DAGSTER_OUTPUT=./dagster_output
STORAGE_MLFLOW=./mlflow
STORAGE_MLFLOW_ARTIFACTS=./mlflow/artifacts
STORAGE_LABEL_STUDIO=./label_studio_data
STORAGE_MINIO=./minio_storage
STORAGE_INFLUXDB=./influxdb_data
STORAGE_GRAFANA=./grafana_data
STORAGE_DEMO_AUDIO=./demo_audio

# ─────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                      # json | text
LOG_FILE=logs/audioops.log

# ─────────────────────────────────────────────────────
# Security
# NOTE: Move SECRET_KEY to .secrets.env for production.
# ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# ─────────────────────────────────────────────────────
# Feature Flags
# Set to false to skip starting a service in docker-compose.
# ─────────────────────────────────────────────────────
ENABLE_MLFLOW=true
ENABLE_LABEL_STUDIO=true
ENABLE_INFERENCE=true
ENABLE_GRAFANA=true
ENABLE_MINIO=true
