# Audio Ops Framework — streaming inference image (FastAPI).
#
#   docker build -f docker/Dockerfile.inference -t audio-ops-inference .
#
# Build args:
#   TORCH_INDEX_URL  PyTorch wheel index. CPU by default; for CUDA use e.g.
#                    https://download.pytorch.org/whl/cu124 (see docker-compose.gpu.yml)
#   EXTRAS           package extras to install (default: serve,s3,metrics)
#   EXTRA_PIP        runtime packages your tasks need, e.g.
#                    "faster-whisper" or "tensorflow-cpu<2.16 tensorflow-hub"
ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
ARG EXTRAS=serve,s3,metrics
ARG EXTRA_PIP=""

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ffmpeg libsndfile1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --index-url "${TORCH_INDEX_URL}" torch

COPY pyproject.toml README.md LICENSE NOTICE ./
COPY audio_ops_dagster ./audio_ops_dagster
COPY audio_ops_inference ./audio_ops_inference
RUN pip install ".[${EXTRAS}]" ${EXTRA_PIP}

RUN mkdir -p /app/models /app/storage /test_audio \
    && useradd --create-home --uid 10001 audioops \
    && chown -R audioops /app /test_audio
USER audioops

ENV PYTHONPATH=/app \
    MODEL_CACHE_DIR=/app/models \
    MODELS_DIR=/app/models

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

# One worker: stream state lives in-process. Scale with more containers.
CMD ["audio-ops", "serve", "--host", "0.0.0.0", "--port", "8000"]
