# Audio Ops Framework — Secrets Template
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: This file contains EXAMPLE values only.
#
# Usage:
#   cp .secrets.env.example .secrets.env
#   chmod 600 .secrets.env
#   nano .secrets.env          ← change every value before starting services
#
# Rules:
#   • Never commit .secrets.env to version control
#   • File should be chmod 600 (owner read/write only)
#   • Rotate all credentials before first production deploy
#   • Use a secrets manager (Vault, AWS Secrets Manager) for production
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────
# MinIO Object Storage
# ─────────────────────────────────────────────────────
MINIO_ROOT_PASSWORD=Ch4ng3Me_M1n10!2026

# Service account for application use (more restricted than root)
MINIO_SERVICE_ACCOUNT_USER=audioops-svc
MINIO_SERVICE_ACCOUNT_PASSWORD=Ch4ng3Me_S3rv1c3!2026

# ─────────────────────────────────────────────────────
# InfluxDB Time-Series Database
# ─────────────────────────────────────────────────────
INFLUXDB_ADMIN_PASSWORD=Ch4ng3Me_Infl1x!2026

# Token used by the application to write/query metrics.
# Generate a real one with: openssl rand -hex 32
INFLUXDB_ADMIN_TOKEN=audioops-token-change-me-00000000000000000000000000000000
INFLUXDB_TOKEN=audioops-token-change-me-00000000000000000000000000000000

# ─────────────────────────────────────────────────────
# Grafana Dashboards
# ─────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=Ch4ng3Me_Gr4f4n4!2026

# Service account token for API access (create in Grafana UI after first login)
GRAFANA_API_TOKEN=glsa_REPLACE_WITH_REAL_GRAFANA_SERVICE_ACCOUNT_TOKEN

# ─────────────────────────────────────────────────────
# Label Studio Annotation Platform
# ─────────────────────────────────────────────────────
LABELSTUDIO_PASSWORD=Ch4ng3Me_L4b3l!2026

# API key — generate in Label Studio UI: Account & Settings → Access Token
LABELSTUDIO_API_KEY=REPLACE_WITH_REAL_LABEL_STUDIO_API_KEY

# ─────────────────────────────────────────────────────
# API / Application Security
# ─────────────────────────────────────────────────────
# Used by the inference service to sign requests.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=b3f1c2d4e5a6789012345678abcdef01b3f1c2d4e5a6789012345678abcdef01

# JWT signing secret (if you add JWT auth to inference API)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=a1b2c3d4e5f6789012345678abcdef01a1b2c3d4e5f6789012345678abcdef01

# Dagster API token (if you enable Dagster Cloud or token auth)
DAGSTER_API_TOKEN=REPLACE_WITH_REAL_DAGSTER_API_TOKEN

# General app secret key
SECRET_KEY=replace-with-long-random-string-generated-by-secrets-module

# ─────────────────────────────────────────────────────
# MLflow Backend (if using an external database instead of SQLite)
# ─────────────────────────────────────────────────────
# Default: SQLite (no credentials needed)
MLFLOW_BACKEND_URI=sqlite:////mlflow/data/mlflow.db

# PostgreSQL example (uncomment and fill in if switching to Postgres):
# MLFLOW_BACKEND_URI=postgresql://mlflow_user:Ch4ng3Me_PG!2026@postgres:5432/mlflow_db

# ─────────────────────────────────────────────────────
# PostgreSQL (optional — if adding a Postgres service)
# ─────────────────────────────────────────────────────
POSTGRES_USER=audioops_user
POSTGRES_PASSWORD=Ch4ng3Me_PG!2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=audioops_db

# ─────────────────────────────────────────────────────
# Redis (optional — for caching or task queuing)
# ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Ch4ng3Me_R3d1s!2026

# ─────────────────────────────────────────────────────
# Cloud Storage (uncomment one block if replacing MinIO with cloud storage)
# ─────────────────────────────────────────────────────

# AWS S3
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-audio-ops-bucket

# Google Cloud Storage
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-service-account.json
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_BUCKET=your-audio-ops-bucket

# Azure Blob Storage
# AZURE_STORAGE_ACCOUNT=yourstorageaccount
# AZURE_STORAGE_KEY=YourBase64StorageKeyHere==
# AZURE_CONTAINER=audio-ops

# ─────────────────────────────────────────────────────
# Email Notifications (optional)
# ─────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-alert-account@gmail.com
# For Gmail: use an App Password, not your real password
# https://support.google.com/accounts/answer/185833
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_ADDRESS=noreply@audioops.local

# ─────────────────────────────────────────────────────
# External Model Registry (optional)
# ─────────────────────────────────────────────────────
MODEL_REGISTRY_URL=https://model-registry.internal
MODEL_REGISTRY_USERNAME=registry-user
MODEL_REGISTRY_PASSWORD=Ch4ng3Me_Reg!2026

# ─────────────────────────────────────────────────────
# Error Monitoring (optional)
# ─────────────────────────────────────────────────────
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ─────────────────────────────────────────────────────
# OpenAI / LLM (optional — if using LLM-assisted labeling or analysis)
# ─────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-REPLACE_WITH_REAL_OPENAI_KEY
